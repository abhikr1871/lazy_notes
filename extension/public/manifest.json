{
    "manifest_version": 3,
    "name": "Lazzy Notes — Universal DSA & YouTube Assistant",
    "version": "1.0.0",
    "description": "AI-powered DSA problem notes, code snippet saver, spaced repetition review queue, and YouTube tutorial assistant.",
    "permissions": [
        "activeTab",
        "storage",
        "contextMenus",
        "scripting",
        "sidePanel",
        "downloads"
    ],
    "host_permissions": [
        "https://lazzy-backend.onrender.com/*"
    ],
    "action": {
        "default_title": "Lazzy Notes",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "options_page": "options.html",
    "background": {
        "service_worker": "assets/background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "assets/content.js"
            ]
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "sidepanel.html",
                "assets/*",
                "icons/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}