{
    "manifest_version": 3,
    "name": "IntelliAsk AI",
    "version": "1.0.0",
    "description": "AI-powered web assistant contextually aware of your browsing.",
    "permissions": [
        "activeTab",
        "storage",
        "contextMenus",
        "scripting",
        "sidePanel"
    ],
    "action": {
        "default_title": "Open IntelliAsk AI",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "options_page": "options.html",
    "background": {
        "service_worker": "assets/background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "assets/content.js"
            ]
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "sidepanel.html",
                "assets/*",
                "icons/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}